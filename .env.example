# Google PageSpeed Insights API key. Optional: without it PSI still works on a
# very low shared quota. Get one at https://developers.google.com/speed/docs/insights/v5/get-started
# Enable the "PageSpeed Insights API" for the project, then use that project's key.
PSI_API_KEY=

# HTTP port for the local server.
PORT=3939

# Where `npm run web:dev` (the UI's dev server, on :5190) sends API calls.
# Set it when the API runs somewhere other than this default.
# PSI_API_URL=http://127.0.0.1:3939

# How many PSI calls may be in flight at once (1-10). Quota cost is per run, not
# per concurrent call, so 10 finishes a 10-run report in one round. Drop to 2
# when running without PSI_API_KEY, whose shared quota rate-limits quickly.
PSI_CONCURRENCY=10

# Other domains this site owns, comma-separated. Without this, a CDN on a sister
# host (static.guvi.in behind www.guvi.co) is filed as third-party cost and the
# work queue tells the agent not to touch it.
PSI_FIRST_PARTY_HOSTS=guvi.in,guvi.co

# MongoDB for the web UI's reports (the server only; the CLI keeps files under
# data/). The dev server is reached through the VPN or a cloudflared tunnel,
# e.g. mongodb://<user>:<password>@127.0.0.1:27017/?authSource=admin
# Use 127.0.0.1, not localhost: the tunnel listens on IPv4 only.
MONGODB_URI=

# Optional. The database name; defaults to PSI-API. Tests use PSI-API-test.
PSI_MONGO_DB=
