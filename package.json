{
  "name": "psi-api",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "PageSpeed Insights API wrapper: multi-run aggregation, insight filtering, performance targets.",
  "engines": {
    "node": ">=18"
  },
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "start": "node dist/server.js",
    "build": "tsc -p tsconfig.json",
    "psi": "tsx src/cli.ts",
    "test": "vitest run",
    "test.watch": "vitest",
    "typecheck": "tsc -p tsconfig.test.json",
    "web:dev": "vite --config web/vite.config.ts",
    "web:build": "vite build --config web/vite.config.ts",
    "web:typecheck": "tsc -p web/tsconfig.json",
    "ui": "npm run web:build && tsx src/server.ts"
  },
  "dependencies": {
    "dotenv": "^16.4.7",
    "fastify": "^5.2.1",
    "zod": "^3.24.1"
  },
  "devDependencies": {
    "@fontsource/ibm-plex-mono": "^5.3.0",
    "@fontsource/ibm-plex-sans": "^5.3.0",
    "@preact/preset-vite": "^2.10.6",
    "@types/node": "^22.10.5",
    "preact": "^10.29.8",
    "tsx": "^4.19.2",
    "typescript": "^5.7.3",
    "vite": "^6.4.6",
    "vitest": "^2.1.8"
  },
  "allowScripts": {
    "esbuild@0.28.2": true,
    "esbuild@0.21.5": true,
    "esbuild@0.25.12": true
  }
}
